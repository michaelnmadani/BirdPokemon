rules_version = '2';

// Only used when cloud sync is enabled (GoogleService-Info.plist bundled).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidSighting(data) {
      return data.keys().hasAll(['id', 'userId', 'speciesCode', 'speciesCommonName', 'capturedAt', 'userOverrode'])
        && data.userId == request.auth.uid
        && data.speciesCode is string && data.speciesCode.size() < 32
        && data.speciesCommonName is string
        && data.capturedAt is timestamp
        && data.userOverrode is bool
        && (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    match /sightings/{sightingId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.id == sightingId && isValidSighting(request.resource.data);
      // Owners may edit their sightings but can't hand them to someone else.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && isValidSighting(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /speciesCache/{code} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}

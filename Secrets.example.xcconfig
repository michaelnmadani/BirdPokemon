// Copy this file to Secrets.xcconfig (gitignored) and fill in your values.
// Everything here is optional for simulator builds.

// Your 10-character Apple Developer Team ID (developer.apple.com → Membership).
DEVELOPMENT_TEAM = ABCDE12345

// A bundle id you own. Must match the App ID in App Store Connect.
APP_BUNDLE_ID = com.yourname.downunderbirdcollector

// Optional: free key from https://ebird.org/api/keygen, so the Nearby tab
// shows recent eBird reports without entering a key in Settings.
EBIRD_API_KEY =
